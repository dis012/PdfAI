# Database Configuration for Local Development
# Use this configuration when running locally (not in Docker)
DB_URL=postgres://pdfai_user:pdfai_password@localhost:5432/pdfai?sslmode=disable

# Python API URL (for local development)
PYTHON_API_URL=http://localhost:8001

# Ollama endpoint (for local development)
OLLAMA_ENDPOINT=http://localhost:11434

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Environment
ENVIRONMENT=development
